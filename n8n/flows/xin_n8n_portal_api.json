      "name": "接收網頁請求",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "webhookId": "77c6087d-a1ad-4131-88c4-a3feb14f3758"
    },
    {
      "parameters": {
        "jsCode": "// 網頁每次送一筆：{ flow, row }。用 text/plain 送出以避開瀏覽器預檢，所以這裡要自己解析字串。\nconst FLOWS = ['WEEKLY','O01','O04','O13','O14','TESTMAIL'];\nlet body = $input.first().json.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nbody = body || {};\nconst flow = String(body.flow || '').toUpperCase();\nconst row = (body.row && typeof body.row === 'object') ? body.row : {};\nreturn [{ json: { ...row, flow, known_flow: FLOWS.includes(flow) } }];"
      },
      "id": "72a32219-2a52-4a0f-b9c9-2798e4b0a2e8",
      "name": "整理輸入",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ]
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 7,
        "output": "={{ ['WEEKLY','O01','O04','O13','O14','TESTMAIL'].indexOf($json.flow) === -1 ? 6 : ['WEEKLY','O01','O04','O13','O14','TESTMAIL'].indexOf($json.flow) }}"
      },
      "id": "998d7f6e-a5a8-4246-a0ae-3656ce0ebd64",
      "name": "依流程分流",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// 檢查並計算：網頁送來的週資料（n8n Code 節點與網頁示範模式共用同一套規則）\nfunction checkAndCalc(b) {\n  b = b || {};\n  const errors = [];\n  const week = String(b.week ?? '').trim();\n  const num = (k) => {\n    const raw = b[k];\n    if (raw === '' || raw === null || raw === undefined) return null;\n    const v = Number(raw);\n    return Number.isFinite(v) ? v : null;\n  };\n  const thisWeek = num('thisWeek'), lastWeek = num('lastWeek'), target = num('target');\n  if (!week) errors.push('缺少週次');\n  if (thisWeek === null) errors.push('本週數字缺漏或不是數字');\n  if (lastWeek === null) errors.push('上週數字缺漏或不是數字');\n  if (target === null) errors.push('目標缺漏或不是數字');\n  if (thisWeek !== null && thisWeek < 0) errors.push('本週數字不能是負數');\n  if (lastWeek !== null && lastWeek <= 0) errors.push('上週數字必須大於 0 才能算成長率');\n  if (target !== null && target <= 0) errors.push('目標必須大於 0 才能算達成率');\n  if (errors.length) return { ok: false, week, errors };\n  const growth = Math.round((thisWeek - lastWeek) / lastWeek * 1000) / 10;\n  const achievement = Math.round(thisWeek / target * 1000) / 10;\n  const subject = `${week} 週報｜成長率 ${growth}%、達成率 ${achievement}%`;\n  const body = [\n    `${week} 週報`,\n    ``,\n    `本週：${thisWeek}`,\n    `上週：${lastWeek}`,\n    `目標：${target}`,\n    `成長率：${growth}%`,\n    `達成率：${achievement}%`,\n  ].join('\\n');\n  return { ok: true, week, thisWeek, lastWeek, target, growth, achievement, subject, body };\n}\n\nreturn $input.all().map(i => ({ json: checkAndCalc(i.json) }));"
      },
